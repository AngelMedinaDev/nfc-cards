---
import clientes from '../data/clientes.json';

// Esta función le dice a Astro qué páginas crear basándose en tu JSON
export function getStaticPaths() {
  return Object.keys(clientes).map((key) => ({
    params: { cliente: key },
    props: { data: clientes[key] },
  }));
}

const { cliente } = Astro.params;
const { data } = Astro.props;

// ---> EL SWITCH MÁGICO MULTI-DESTINO <---
if (data.redireccion === 'maps') {
  return Astro.redirect(data.maps);
} else if (data.redireccion === 'insta') {
  return Astro.redirect(data.insta);
}

// Variables dinámicas para el diseño premium
const brandColor = data.color || '#1f2937';
const logoUrl = data.logo || `https://ui-avatars.com/api/?name=${data.nombre?.replace(/ /g, '+')}&background=random&color=fff`;
---

<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{data.nombre} | Califícanos</title>
    
    <!-- Aquí pasamos el color de la marca al CSS -->
    <style define:vars={{ brandColor }}>
        * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
        body { 
            background-color: #f3f4f6; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0; 
            padding: 20px;
        }
        .card { 
            background: white; 
            padding: 2.5rem 2rem 2rem 2rem; 
            border-radius: 1.5rem; 
            box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1); 
            text-align: center; 
            max-width: 400px; 
            width: 100%;
            border-top: 8px solid var(--brandColor);
            margin-top: 30px;
        }
        .logo-container {
            width: 80px;
            height: 80px;
            margin: -4.5rem auto 1rem auto;
            border-radius: 50%;
            background: white;
            padding: 4px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        .logo {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }
        h1 { color: #1f2937; margin-top: 0; margin-bottom: 0.5rem; font-size: 1.4rem; font-weight: 800;}
        p { color: #6b7280; margin-bottom: 2rem; font-size: 0.95rem; line-height: 1.5;}
        
        .btn { 
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%; 
            padding: 1rem; 
            margin-bottom: 1rem; 
            border-radius: 0.75rem; 
            text-decoration: none; 
            font-weight: 600; 
            font-size: 1rem;
            transition: transform 0.1s, box-shadow 0.2s; 
        }
        .btn:active { transform: scale(0.98); }
        
        /* Botón Oficial Google */
        .btn-google { 
            background-color: white; 
            color: #3c4043;
            border: 1px solid #dadce0;
            box-shadow: 0 1px 2px 0 rgba(60,64,67,0.3);
        }
        .btn-google:hover { background-color: #f8f9fa; }

        /* Botón Oficial Insta */
        .btn-insta { 
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%); 
            color: white;
            border: none;
        }
        .btn-insta:hover { opacity: 0.95; box-shadow: 0 4px 12px rgba(220, 39, 67, 0.3); }
        
        .icon { width: 22px; height: 22px; }
    </style>
</head>
<body>
    <div class="card">
        <div class="logo-container">
            <img src={logoUrl} alt={`Logo de ${data.nombre}`} class="logo" />
        </div>
        <h1>{data.nombre}</h1>
        <p>¡Gracias por visitarnos! Tu opinión nos ayuda a darte un mejor servicio.</p>

        <a href={data.maps} class="btn btn-google">
            <svg class="icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
            </svg>
            Calificar en Google
        </a>

        <a href={data.insta} class="btn btn-insta">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            Síguenos en Instagram
        </a>
    </div>
</body>
</html>
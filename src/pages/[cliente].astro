---
import clientes from './data/clientes.json';

// 1. Obtenemos el parámetro de la URL
const { cliente } = Astro.params;

// 2. Buscamos al cliente forzando el tipo para que TypeScript no marque error
const datosCliente = (clientes as any)[cliente as string];

// 3. Seguridad: Si escanean un QR de un cliente que borraste o no existe, mándalos a tu página principal
if (!datosCliente) {
  return Astro.redirect('/', 302);
}

// 4. Redirección instantánea a Google Maps
if (datosCliente.redireccion === 'maps' && datosCliente.maps) {
  return Astro.redirect(datosCliente.maps, 302);
}

// 5. Redirección instantánea a Instagram
if (datosCliente.redireccion === 'insta' && datosCliente.insta) {
  return Astro.redirect(datosCliente.insta, 302);
}

// 6. Si el cliente NO tiene una redirección directa (ej. el genérico Multi-Enlace),
// entonces sí dejas que cargue el HTML de aquí abajo.
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Conecta con {datosCliente.nombre}</title>
</head>
<body style={`background-color: ${datosCliente.color}`}>
  <!-- Aquí pones el diseño de tu Multi-Enlace (Link Hub) -->
  <img src={datosCliente.logo} alt={`Logo de ${datosCliente.nombre}`} />
  <h1>{datosCliente.nombre}</h1>
</body>
</html>